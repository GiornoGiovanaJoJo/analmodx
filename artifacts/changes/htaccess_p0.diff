--- /workspace/artifacts/changes/htaccess_before_p0.txt	2026-05-04 16:39:03.269645959 +0000
+++ /workspace/artifacts/changes/htaccess_after_p0.txt	2026-05-04 16:39:00.745647149 +0000
@@ -599,6 +599,27 @@
 
 
 
+
+# >>> P0 URL normalization (cursor 2026-05-04) >>>
+# Strip the noise q= parameter when its target is NOT the MODX entry point.
+# robots.txt already disallows *?*q=. Returning 301 on non-/index.php gives
+# crawlers a clean URL instead of a soft-404. 
+RewriteCond %{REQUEST_URI} !^/index\.php$ [NC]
+RewriteCond %{QUERY_STRING} (^|&)q= [NC]
+RewriteRule ^(.*)$ /$1? [R=301,L]
+
+# Collapse any doubled slashes in the request line into one (single-hop).
+# Uses THE_REQUEST because Apache may already merge slashes in REQUEST_URI.
+RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^?]*?)//+([^\s?]*)([\s?].*)?\sHTTP/ [NC]
+RewriteRule .* %1/%2 [R=301,L]
+
+# Conservative response headers (no caching impact).
+<IfModule mod_headers.c>
+  Header always set X-Content-Type-Options "nosniff"
+  Header always set Referrer-Policy "strict-origin-when-cross-origin"
+</IfModule>
+# <<< P0 URL normalization (cursor 2026-05-04) <<<
+
 # The Friendly URLs part
 RewriteCond %{REQUEST_FILENAME} !-f
 RewriteCond %{REQUEST_FILENAME} !-d
